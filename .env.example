# ==========================================
# SMARTGLOW ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure secrets locally.
# Never commit .env to version control.
# ==========================================

# -----------------
# Web Storefront (React / Vite)
# -----------------
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_APP_TITLE="SmartGlow Cosmetics"
APP_URL="MY_APP_URL"

# -----------------
# Backend API (FastAPI)
# -----------------
PROJECT_NAME="SmartGlow API"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------
# Database (PostgreSQL)
# -----------------
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="smartglow_user"
POSTGRES_PASSWORD="smartglow_password"
POSTGRES_DB="smartglow_db"
DATABASE_URL="postgresql+asyncpg://smartglow_user:smartglow_password@localhost:5432/smartglow_db"

# -----------------
# AI & Skin Analysis Service
# -----------------
AI_MODEL_PATH="ai/models/smartglow_skin_analyzer_v1.keras"
AI_CONFIDENCE_THRESHOLD=0.75
MAX_IMAGE_UPLOAD_SIZE_MB=10
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# -----------------
# Storage & Uploads
# -----------------
UPLOAD_DIR="./uploads"
ENABLE_IMAGE_EPHEMERAL_MODE=True
